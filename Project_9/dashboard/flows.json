    {
        "id": "fn_clamp_speed",
        "type": "function",
        "z": "f_task31",
        "name": "Clamp speed 0-100",
        "func": "let v = Number(msg.payload);\nif (isNaN(v)) {\n    v = 0;\n}\nif (v < 0) {\n    v = 0;\n} else if (v > 100) {\n    v = 100;\n}\nmsg.payload = String(Math.round(v));\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
