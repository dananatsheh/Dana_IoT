    {
        "id": "fn_conn_monitor",
        "type": "function",
        "z": "f_task31",
        "name": "Connection monitor ",
        "func": "const STALE_MS = 8000;\n\nlet ctx = context.get('conn') || { online: false, lastSeen: 0 };\n\nif (msg.topic === 'device/esp32/status') {\n    ctx.online = (msg.payload === 'online');\n    if (ctx.online) {\n        ctx.lastSeen = Date.now();\n    }\n} else if (msg.topic === 'tick') {\n} else {\n    ctx.lastSeen = Date.now();\n}\n\ncontext.set('conn', ctx);\n\nconst stale = (Date.now() - ctx.lastSeen) > STALE_MS;\n\nlet status, color;\nif (!ctx.online) {\n    status = 'OFFLINE';\n    color = '#c62828';\n} else if (stale) {\n    status = 'STALE';\n    color = '#f9a825';\n} else {\n    status = 'ONLINE';\n    color = '#2e7d32';\n}\n\nreturn { payload: { status: status, color: color } };\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 540,
        "wires": [
            [
                "tpl_conn_status",
                "c4b797465c4401a0"
            ]
        ]
    },
