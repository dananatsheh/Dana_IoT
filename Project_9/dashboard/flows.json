        "func": "let state = flow.get('firebaseCurrent') || {};\n\nswitch (msg.topic) {\n    case 'sensor/bme280/temperature':\n        state.temperature = msg.payload;\n        break;\n    case 'sensor/bme280/humidity':\n        state.humidity = msg.payload;\n        break;\n    case 'sensor/bme280/pressure':\n        state.pressure = msg.payload;\n        break;\n    case 'motor/status/state':\n        state.motor = state.motor || {};\n        state.motor.state = msg.payload;\n        break;\n    case 'motor/status/direction':\n        state.motor = state.motor || {};\n        state.motor.direction = msg.payload;\n        break;\n    case 'motor/status/speed':\n        state.motor = state.motor || {};\n        state.motor.speed = Number(msg.payload);\n        break;\n    default:\n        if (msg.payload && typeof msg.payload === 'object' && msg.payload.status) {\n             state.status = msg.payload.status.toLowerCase(); \n        } else {\n            return null;\n        }\n}\n\nstate.lastUpdated = Date.now();\nflow.set('firebaseCurrent', state);\n\nmsg.payload = state;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
